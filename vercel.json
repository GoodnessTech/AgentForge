{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd \"AgentForge Frontend\" && pnpm install && pnpm run build",
  "outputDirectory": "AgentForge Frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
